# NGA target
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# Shared read-only viewer login is root / root. Restrict the app to a trusted network.
NGA_URL=https://nga.laas.intel.com/#/dmr_pv/planning/testlines

# Filter row applied on the Testlines page: <entity> / <field> / <operator> / <value>
NGA_FILTER_ENTITY=TestLine
NGA_FILTER_FIELD=Suite
NGA_FILTER_OPERATOR=Equal
NGA_SUITE_NAME=Oak_Stream_Platform_1_DMR-Platform_Beta-PAIV-Platform-AP1_Beta_Regression_Cycle

# Grid column that carries each test's execution state
NGA_STATE_COLUMN=Last Rerun State

# The Testlines page opens frozen until this button is pressed
NGA_UNLOCK_BUTTON=Get Latest Testline

# Browser control
# Set to "false" the first time so you can complete Intel SSO interactively.
NGA_HEADLESS=true
# Reuses your logged-in Chrome (channel chrome). Use "chromium" to fall back to bundled build.
NGA_BROWSER_CHANNEL=chrome
# Persistent profile dir keeps the SSO session between runs.
NGA_PROFILE_DIR=.browser-profile
NGA_NAV_TIMEOUT_MS=120000
NGA_SETTLE_MS=6000
# Explicit Intel NGAi DataSearch endpoint. Override this only when Intel provides
# a different approved gateway URL for your environment.
NGAI_API_URL=https://nga-prod.laas.icloud.intel.com/Search/dmr_pv/odata/v1/TestRunComposite
NGAI_API_TOKEN=
NGAI_COOKIE=

# If Intel's corporate proxy CA is installed in the Windows certificate store:
#$env:NODE_USE_SYSTEM_CA = '1'
# Otherwise ask IT for the complete corporate CA chain and set:
$env:NODE_EXTRA_CA_CERTS = 'C:\certs\intel-corporate-root-ca.cer'